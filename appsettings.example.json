{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=team_availability;Username=postgres;Password=YOUR_POSTGRES_PASSWORD",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Jwt": {
    "Issuer": "TeamAvailability",
    "Audience": "TeamAvailabilityClients",
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 60
  },
  "Telegram": {
    "BotToken": "",
    "UseWebhook": false,
    "WebhookSecret": ""
  },
  "Jira": {
    "Enabled": false,
    "BaseUrl": "https://your-domain.atlassian.net",
    "Email": "you@company.com",
    "ApiToken": "",
    "ProjectKey": "KAN",
    "IssueType": "Task",
    "IssueTypeId": "10003"
  },
  "LocalDev": {
    "UseMemoryCache": true,
    "UseInMemoryBus": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
